generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum InviteStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum OccurrenceStatus {
  OPEN
  CLAIMED
  COMPLETED
  SKIPPED
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  username     String            @unique @db.VarChar(30)
  email        String            @unique @db.VarChar(320)
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  GroupMembership[]
  createdTasks Task[]            @relation("TaskCreator")
  assignees    TaskOccurrence[]  @relation("OccurrenceAssignee")
  claimants    TaskOccurrence[]  @relation("OccurrenceClaimant")
}

model Group {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupMembership[]
  invites     GroupInvite[]
  tasks       Task[]
}

// A user may be in multiple households. The API must ensure each group has exactly one ADMIN.
model GroupMembership {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id        String       @id @default(uuid()) @db.Uuid
  groupId   String       @db.Uuid
  code      String       @unique @db.VarChar(32)
  status    InviteStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
}

// A Task is the chore definition. For repeats, its RecurrenceRule produces dated TaskOccurrences.
model Task {
  id               String           @id @default(uuid()) @db.Uuid
  groupId          String           @db.Uuid
  createdById      String           @db.Uuid
  title            String           @db.VarChar(200)
  description      String?
  difficulty       Difficulty       @default(MEDIUM)
  points           Int              @default(1)
  estimatedMinutes Int?
  dueAt            DateTime?
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  group            Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("TaskCreator", fields: [createdById], references: [id])
  recurrence       RecurrenceRule?
  occurrences      TaskOccurrence[]

  @@index([groupId, archivedAt])
}

model RecurrenceRule {
  id          String              @id @default(uuid()) @db.Uuid
  taskId      String              @unique @db.Uuid
  frequency   RecurrenceFrequency
  interval    Int                 @default(1)
  daysOfWeek  Int[]               // 0=Sunday through 6=Saturday; used for WEEKLY
  endsAt      DateTime?
  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// One row is a real dated instance: it supports claiming, reassignment, completion, and skipped repeats.
model TaskOccurrence {
  id             String           @id @default(uuid()) @db.Uuid
  taskId         String           @db.Uuid
  scheduledFor   DateTime
  status         OccurrenceStatus @default(OPEN)
  assignedUserId String?          @db.Uuid
  claimedById    String?          @db.Uuid
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedUser   User?            @relation("OccurrenceAssignee", fields: [assignedUserId], references: [id])
  claimedBy      User?            @relation("OccurrenceClaimant", fields: [claimedById], references: [id])

  @@unique([taskId, scheduledFor])
  @@index([assignedUserId, scheduledFor])
  @@index([taskId, status])
}
